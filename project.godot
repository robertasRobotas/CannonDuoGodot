; Engine configuration file.
; Cannon Duo, Godot 4.7

config_version=5

[application]

config/name="Cannon Duo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[audio]

general/ios/session_category=3
general/ios/mix_with_others=true

[display]

window/size/viewport_width=1179
window/size/viewport_height=2556
window/size/window_width_override=393
window/size/window_height_override=852
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.93, 0.66, 0.62, 1)
